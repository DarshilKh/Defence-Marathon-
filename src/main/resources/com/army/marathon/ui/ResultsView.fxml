<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.army.marathon.ui.ResultsController"
            stylesheets="@../styles/theme.css"
            prefWidth="1700" prefHeight="950">

    <top>
        <VBox spacing="14" styleClass="header-bar">

            <!-- Title Bar -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="🏆 Race Results &amp; Analysis" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Race:" styleClass="header-subtext"/>
                <Label fx:id="raceNameLabel" text="Loading..." styleClass="header-value"/>
            </HBox>

            <!-- Read-only: calculation now happens on the Live Tracking tab -->
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="section-card">
                <Label text="📋 Results calculated from the Live Tracking tab appear here automatically" styleClass="section-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Export:" styleClass="section-label"/>
                <Button fx:id="exportExcelButton" text="📊 Excel" onAction="#handleExportExcel"
                        styleClass="btn, btn-success"/>
                <Button fx:id="refreshButton" text="🔄 Refresh" onAction="#handleRefresh"
                        styleClass="btn, btn-primary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 12 16 16 16;">

            <!-- Summary Cards: compact -->
            <HBox spacing="14" alignment="CENTER_LEFT">
                <!-- Finishers Card -->
                <VBox spacing="2" alignment="CENTER" styleClass="stat-card"
                      style="-fx-border-color: #2c5f8a; -fx-border-width: 0 0 0 4; -fx-min-width: 140; -fx-padding: 8 16;">
                    <Label text="FINISHERS" styleClass="stat-card-label"/>
                    <Label fx:id="totalFinishersLabel" text="0" styleClass="stat-card-value" style="-fx-text-fill: #2c5f8a; -fx-font-size: 24px;"/>
                </VBox>

                <!-- DNF Card -->
                <VBox spacing="2" alignment="CENTER" styleClass="stat-card"
                      style="-fx-border-color: #c0392b; -fx-border-width: 0 0 0 4; -fx-min-width: 120; -fx-padding: 8 16;">
                    <Label text="DNF" styleClass="stat-card-label"/>
                    <Label fx:id="totalDnfLabel" text="0" styleClass="stat-card-value" style="-fx-text-fill: #c0392b; -fx-font-size: 24px;"/>
                </VBox>

                <!-- Winner Card -->
                <HBox fx:id="winnerCard" spacing="12" alignment="CENTER_LEFT" styleClass="stat-card"
                      style="-fx-border-color: #a6791f; -fx-border-width: 0 0 0 4; -fx-min-width: 320; -fx-padding: 8 16;">
                    <Label text="🏅" style="-fx-font-size: 24px;"/>
                    <VBox spacing="1" alignment="CENTER">
                        <Label text="WINNER" styleClass="winner-tag" style="-fx-text-fill: #a6791f;"/>
                        <Label fx:id="winnerNameLabel" text="N/A" styleClass="winner-name" style="-fx-text-fill: #123a5c;"
                               maxWidth="200" wrapText="false"/>
                        <Label fx:id="winnerTimeLabel" text="--:--:--" styleClass="winner-time" style="-fx-text-fill: #a6791f; -fx-font-size: 18px;"
                               maxWidth="200" alignment="CENTER"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Results Table: gets the majority of the remaining height -->
            <VBox VBox.vgrow="ALWAYS" spacing="6" styleClass="panel">

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar-flat"
                      style="-fx-padding: 8 14; -fx-background-radius: 4;">
                    <Label text="📋 Final Results" styleClass="header-title" style="-fx-font-size: 15px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultsHintLabel" text="" styleClass="header-subtext"/>
                </HBox>

                <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="rankColumn" text="Rank" prefWidth="60"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="serviceNoColumn" text="Tag No" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="rankArmyColumn" text="Army Rank" prefWidth="90"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="unitColumn" text="Unit" prefWidth="120"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="90"
                                     style="-fx-alignment: CENTER;"/>

                        <!-- Dynamic checkpoint columns inserted here by controller -->

                        <TableColumn fx:id="totalTimeColumn" text="Total Time" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 26;">
                            <Label text="📊 No Results Available" styleClass="placeholder-title"/>
                            <Label text="Go to the Live Tracking tab, stop the race, choose a calculation mode and click 'Calculate Results'" styleClass="placeholder-text"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Manual Start (dual timing) results: a different table shape, shown instead of the one above -->
                <TableView fx:id="dualTimingTable" VBox.vgrow="ALWAYS" visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="dualNameColumn" text="Name" prefWidth="180"
                                     style="-fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="dualTagNoColumn" text="Tag No" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualUnitColumn" text="Unit" prefWidth="120"
                                     style="-fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="dualStatusColumn" text="Status" prefWidth="110"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualDeclaredStartColumn" text="Declared Start" prefWidth="150"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualStartColumn" text="Start Time" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualFinishColumn" text="Finish Time" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualDeclaredDurationColumn" text="Duration (Declared Start)" prefWidth="170"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualStartDurationColumn" text="Duration (Start Time)" prefWidth="150"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualNoteColumn" text="Note" prefWidth="220" editable="true"
                                     style="-fx-alignment: CENTER_LEFT;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 26;">
                            <Label text="📊 No Results Available" styleClass="placeholder-title"/>
                            <Label text="Declare the start with 'Set', stop the race and click 'Calculate Results' on the Live Tracking tab" styleClass="placeholder-text"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>
