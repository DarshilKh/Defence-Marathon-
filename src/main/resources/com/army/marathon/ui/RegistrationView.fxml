<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.army.marathon.ui.RegistrationController"
            stylesheets="@../styles/theme.css"
            prefWidth="1500" prefHeight="900">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header-bar-flat">
            <Label text="👤 Registration" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="readerStatusLabel" text="🔴 Reader Disconnected" styleClass="header-subtext" style="-fx-text-fill: #e74c3c;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #eef2f6; -fx-background: #eef2f6;">
        <VBox spacing="0">

            <VBox spacing="16" style="-fx-padding: 18; -fx-background-color: #eef2f6;">

                <!-- RFID Section -->
                <VBox spacing="10" styleClass="card">
                    <Label text="▶ RFID TAG" styleClass="card-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="RFID Tag: *" styleClass="field-label" minWidth="90" maxWidth="90"/>
                        <TextField fx:id="rfidTagField" promptText="Scan or enter RFID tag"
                                   HBox.hgrow="ALWAYS" styleClass="text-field"/>
                        <Button fx:id="scanButton" text="📡 Scan" onAction="#handleScan" styleClass="btn, btn-primary"/>
                    </HBox>
                </VBox>

                <!-- PERSONAL DETAILS -->
                <VBox spacing="12" styleClass="card">
                    <Label text="▶ PERSONAL DETAILS (only Tag No is required)" styleClass="card-title"/>

                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <!-- Row 1 -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Name:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <TextField fx:id="nameField" promptText="Full Name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="text-field"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Tag No: *" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <TextField fx:id="serialNoField" promptText="Required"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="text-field"/>
                        </HBox>

                        <!-- Row 2 -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Service No:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <TextField fx:id="serviceNumberField" promptText="Service Number"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="text-field"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Unit:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <ComboBox fx:id="unitComboBox" promptText="Select Unit"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false" styleClass="combo-box"/>
                        </HBox>

                        <!-- Row 3 -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Rank:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <ComboBox fx:id="rankComboBox" promptText="Select Rank"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false" styleClass="combo-box"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="DOB:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <DatePicker fx:id="dobPicker" promptText="Date of Birth"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="date-picker"/>
                        </HBox>

                        <!-- Row 4 -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="Age Group:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <TextField fx:id="ageGroupField" promptText="Auto" editable="false"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="text-field"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label text="Age:" styleClass="field-label" minWidth="90" maxWidth="90"/>
                            <TextField fx:id="ageField" promptText="Auto" editable="false"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="text-field"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- ACTION BUTTONS -->
                <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8 0;">
                    <Button fx:id="saveButton" text="💾 Save" onAction="#handleSave" styleClass="btn, btn-success"/>
                    <Button fx:id="editButton" text="✏️ Edit" onAction="#handleEdit" disable="true" styleClass="btn, btn-amber"/>
                    <Button fx:id="deleteButton" text="🗑️ Delete" onAction="#handleDelete" disable="true" styleClass="btn, btn-danger"/>
                    <Button fx:id="clearButton" text="🔄 Clear" onAction="#handleClear" styleClass="btn, btn-neutral"/>

                    <Separator orientation="VERTICAL" prefHeight="32"/>

                    <Button fx:id="downloadTemplateButton" text="📄 Download Template" onAction="#handleDownloadTemplate" styleClass="btn, btn-teal"/>
                    <Button fx:id="uploadExcelButton" text="📤 Upload Excel" onAction="#handleUploadExcel" styleClass="btn, btn-purple"/>
                    <Button fx:id="refreshButton" text="🔃 Refresh" onAction="#handleRefresh" styleClass="btn, btn-teal"/>
                </HBox>

            </VBox>

            <!-- TABLE SECTION -->
            <VBox spacing="10" style="-fx-padding: 14; -fx-background-color: #eef2f6;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📋 Registered Participants" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="🔍 Search:" styleClass="field-label"/>
                    <TextField fx:id="searchField"
                               promptText="Enter RFID Tag or Tag No"
                               prefWidth="380" styleClass="text-field"/>
                    <Button text="🔍 Search" onAction="#handleSearchButton" styleClass="btn, btn-primary"/>
                </HBox>

                <TableView fx:id="participantTable" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                    <columns>
                        <TableColumn fx:id="rfidTagColumn" text="RFID Tag" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="160" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="serviceNumberColumn" text="Service No" prefWidth="110" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="rankColumn" text="Rank" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="unitColumn" text="Unit" prefWidth="140" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="serialNoColumn" text="Tag No" prefWidth="90" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="dobColumn" text="DOB" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="ageColumn" text="Age" prefWidth="70" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="ageGroupColumn" text="Age Group" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="No participants registered yet. Click 'Save' to add." styleClass="placeholder-text"/>
                    </placeholder>
                </TableView>

                <HBox spacing="24" alignment="CENTER_LEFT" styleClass="status-bar">
                    <Label text="Total:" styleClass="field-label"/>
                    <Label fx:id="totalCountLabel" text="0" styleClass="status-value-blue"/>
                </HBox>
            </VBox>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>