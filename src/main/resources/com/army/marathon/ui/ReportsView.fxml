<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.army.marathon.ui.ReportsController"
            stylesheets="@../styles/theme.css"
            prefWidth="1700" prefHeight="950">

    <top>
        <VBox spacing="12" styleClass="header-bar">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="📅 Reports" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Historical race attempts, independent of Live Tracking - opening or using this tab never resets, arms, starts, stops or recalculates anything." styleClass="header-subtext" wrapText="true" maxWidth="520"/>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="section-card">
                <Label text="Date Range:" styleClass="section-label"/>
                <ToggleButton fx:id="todayButton" text="Today" styleClass="btn, btn-primary"/>
                <ToggleButton fx:id="yesterdayButton" text="Yesterday" styleClass="btn, btn-primary"/>
                <ToggleButton fx:id="customRangeButton" text="Custom Range" styleClass="btn, btn-primary"/>

                <HBox fx:id="customRangeBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                    <Label text="From:" styleClass="section-label"/>
                    <DatePicker fx:id="fromDatePicker" styleClass="date-picker" prefWidth="150"/>
                    <Label text="To:" styleClass="section-label"/>
                    <DatePicker fx:id="toDatePicker" styleClass="date-picker" prefWidth="150"/>
                    <Button fx:id="applyRangeButton" text="Apply" onAction="#handleApplyCustomRange" styleClass="btn, btn-success"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="rangeSummaryLabel" text="" styleClass="section-label"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.34" style="-fx-padding: 12 16 16 16; -fx-background-color: #eaf3fb;">

            <!-- Left: the list of past attempts in the selected range -->
            <VBox spacing="8" styleClass="panel">
                <Label text="🏁 Race Attempts" styleClass="panel-title"/>
                <TableView fx:id="sessionsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="sessionRaceNameColumn" text="Race" prefWidth="150" style="-fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="sessionDateColumn" text="Date" prefWidth="130" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="sessionModeColumn" text="Mode" prefWidth="150" style="-fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="sessionParticipantsColumn" text="Participants" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="sessionCompletedColumn" text="Completed" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="sessionActionColumn" text="" prefWidth="80" sortable="false" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 26;">
                            <Label text="📭 No race attempts in this range" styleClass="placeholder-title"/>
                            <Label text="Pick a different date range, or run a race on Live Tracking first" styleClass="placeholder-text"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Right: the selected attempt's results, same rendering as the Results tab -->
            <VBox spacing="10" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar-flat"
                      style="-fx-padding: 8 14; -fx-background-radius: 4;">
                    <Label fx:id="selectedSessionLabel" text="Select a race attempt on the left" styleClass="header-title" style="-fx-font-size: 15px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Finishers:" styleClass="header-subtext"/>
                    <Label fx:id="totalFinishersLabel" text="0" styleClass="header-value"/>
                    <Label text="DNF:" styleClass="header-subtext"/>
                    <Label fx:id="totalDnfLabel" text="0" styleClass="header-value"/>
                    <Button fx:id="exportExcelButton" text="📊 Export Excel" onAction="#handleExportExcel"
                            disable="true" styleClass="btn, btn-success"/>
                </HBox>

                <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="rankColumn" text="Rank" prefWidth="60" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="180" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="serviceNoColumn" text="Tag No" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="rankArmyColumn" text="Army Rank" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="unitColumn" text="Unit" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="90" style="-fx-alignment: CENTER;"/>

                        <!-- Dynamic checkpoint columns inserted here by controller -->

                        <TableColumn fx:id="totalTimeColumn" text="Total Time" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="No results calculated for this attempt" styleClass="placeholder-text"/>
                    </placeholder>
                </TableView>

                <!-- Manual Start (dual timing) results: a different table shape, shown instead of the one above -->
                <TableView fx:id="dualTimingTable" VBox.vgrow="ALWAYS" visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="dualNameColumn" text="Name" prefWidth="180" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualTagNoColumn" text="Tag No" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualUnitColumn" text="Unit" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualStatusColumn" text="Status" prefWidth="110" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualDeclaredStartColumn" text="Declared Start" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualStartColumn" text="Start Time" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualFinishColumn" text="Finish Time" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualDeclaredDurationColumn" text="Duration (Declared Start)" prefWidth="170" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualStartDurationColumn" text="Duration (Start Time)" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="dualNoteColumn" text="Note" prefWidth="220" style="-fx-alignment: CENTER_LEFT;"/>
                    </columns>
                    <placeholder>
                        <Label text="No results calculated for this attempt" styleClass="placeholder-text"/>
                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>

</BorderPane>
