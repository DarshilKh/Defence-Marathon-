<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>
    
    <groupId>com.army.marathon</groupId>
    <artifactId>airforce-marathon-rfid</artifactId>
    <version>1.0.0</version>
    <name>Indian Defence Marathon RFID Timing System</name>
    <description>Complete RFID Race Timing System for the Indian Defence Forces</description>
    
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>21.0.5</javafx.version>
        <poi.version>5.2.5</poi.version>
    </properties>
    
    <dependencies>
        <!-- Spring Boot Core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        
        <!-- Spring Boot Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.44.1.0</version>
        </dependency>
        
        <!-- Hibernate SQLite Dialect -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        
        <!-- JavaFX Dependencies -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <!-- JavaFX Spring Integration -->
        <dependency>
            <groupId>net.rgielen</groupId>
            <artifactId>javafx-weaver-spring-boot-starter</artifactId>
            <version>1.3.0</version>
        </dependency>
        
        <!-- Apache POI for Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        
        <!-- JNA for RFID Reader DLL -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.15.2</version>
        </dependency>
        
        <!-- ✅ RFID READER JARS - Will be auto-installed from lib/ folder -->
        <dependency>
            <groupId>com.clou.unrf</groupId>
            <artifactId>reader-api</artifactId>
            <version>3.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/ReaderAPI.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>org.rxtx</groupId>
            <artifactId>rxtx</artifactId>
            <version>2.1.7</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/RXTXcomm.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.symbol</groupId>
            <artifactId>rfid-api</artifactId>
            <version>3.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Symbol_RFID_API3.jar</systemPath>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <!-- ✅✅✅ AUTO-INSTALL JARs FROM lib/ FOLDER -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <!-- Install ReaderAPI.jar -->
                    <execution>
                        <id>install-reader-api</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${project.basedir}/lib/ReaderAPI.jar</file>
                            <groupId>com.clou.uhf</groupId>
                            <artifactId>reader-api</artifactId>
                            <version>3.0</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                    
                    <!-- Install RXTXcomm.jar -->
                    <execution>
                        <id>install-rxtx</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${project.basedir}/lib/RXTXcomm.jar</file>
                            <groupId>org.rxtx</groupId>
                            <artifactId>rxtx</artifactId>
                            <version>2.1.7</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                    
                    <!-- Install Symbol_RFID_API3.jar -->
                    <execution>
                        <id>install-symbol-rfid</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${project.basedir}/lib/Symbol_RFID_API3.jar</file>
                            <groupId>com.symbol</groupId>
                            <artifactId>rfid-api</artifactId>
                            <version>3.0</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- ✅ lib/ holds native DLLs the vendor SDKs JNI-bridge into
                         (UHFReader18.dll for CLOU, and RFIDAPI3_JNI_HOST.dll for
                         Zebra once it's placed there - Zebra's is a separate
                         download from their RFID3 API for Java SDK, NOT bundled
                         with 123RFID Desktop or the Symbol_RFID_API3.jar). Nothing
                         in this project previously put lib/ on java.library.path,
                         so com.mot.rfid.api3.API3Natives' static initializer threw
                         UnsatisfiedLinkError on the very first Zebra connect
                         attempt every run. This only covers `mvnw spring-boot:run`
                         - an IntelliJ Run Configuration launching MarathonApplication
                         directly needs the same -Djava.library.path added to its
                         own VM options (Run > Edit Configurations). -->
                    <jvmArguments>-Djava.library.path=${project.basedir}/lib --add-opens java.base/java.lang=ALL-UNNAMED</jvmArguments>
                </configuration>
            </plugin>

            <!-- ✅ Copy DLL files to target directory -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-lib</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/lib</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.army.marathon.MarathonApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      Standalone Windows app (no Java / Maven / MySQL needed on the target PC):

          mvnw clean package -Ppackage-exe -DskipTests

      Output: target/dist/AirForceMarathon/AirForceMarathon.exe (a self-contained app-image
      folder - copy the whole folder anywhere writable and run the .exe).

      Needs Maven running on a full JDK 21 (JAVA_HOME), because jpackage ships with the JDK.
      The app-image type is used because WiX (required for msi/exe installers) is not installed;
      switch <jpackage.type> to exe or msi once WiX 3.x is on PATH.

      Not part of the normal build: without -Ppackage-exe nothing here runs.
    -->
    <profiles>
        <!-- jpackage writes AirForceMarathon.exe read-only, and maven-clean cannot delete read-only
             files on Windows, so ANY later "mvnw clean" (with or without -Ppackage-exe) would die on
             target/dist. This profile switches itself on under Windows and clears the flag just before
             clean runs. It does nothing when target/dist does not exist. -->
        <profile>
            <id>unlock-packaged-output</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <jpackage.dest>${project.build.directory}/dist</jpackage.dest>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>unlock-packaged-output</id>
                                <phase>pre-clean</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>cmd</executable>
                                    <arguments>
                                        <argument>/c</argument>
                                        <argument>if exist "${jpackage.dest}" attrib -R /S /D "${jpackage.dest}\*"</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>package-exe</id>

            <properties>
                <jpackage.name>AirForceMarathon</jpackage.name>
                <jpackage.type>app-image</jpackage.type>
                <jpackage.vendor>NTS - Network Toll Solution</jpackage.vendor>
                <jpackage.version>1.0.0</jpackage.version>
                <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
                <jpackage.dest>${project.build.directory}/dist</jpackage.dest>
                <!-- JDK modules the app needs, derived by running the JDK's jdeps tool (print-module-deps mode)
                     over the app jar and all dependency jars, plus jdk.crypto.ec (TLS, in case database.mode is switched back to MySQL),
                     jdk.zipfs and jdk.management. java.sql.rowset pulls in java.sql/java.naming/
                     java.logging/java.xml/java.transaction.xa. Everything else in the JDK is left out. -->
                <jpackage.modules>java.base,java.compiler,java.desktop,java.instrument,java.management,java.naming,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.sql,java.sql.rowset,java.xml.crypto,jdk.crypto.ec,jdk.jfr,jdk.management,jdk.unsupported,jdk.zipfs</jpackage.modules>
            </properties>

            <build>
                <plugins>
                    <!-- Keep the plain jar: jpackage puts every dependency jar on the classpath itself,
                         and the Spring Boot fat jar would leave out the system-scope vendor jars. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>repackage</id>
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- The dev application.properties (MySQL host + password) must not ship in the
                         handed-off jar; the packaged build reads config/application.properties instead. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>application.properties</exclude>
                                <exclude>logo/NTS Logo-100.jpg</exclude>
                                <exclude>docs/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>

                    <!-- Assemble jpackage's input folder: jar + dependency jars + lib/ + config/ + empty runtime folders -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-copy-app-jar</id>
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes><include>${project.build.finalName}.jar</include></includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-copy-lib</id>
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <!-- all jars + native DLLs, where AppPaths.libDir() expects them. jpackage puts
                                         every jar under its input folder (recursively) on the classpath, so the
                                         vendor system-scope jars are covered by this copy too. -->
                                    <outputDirectory>${jpackage.input}/lib</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/lib</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-copy-config</id>
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}/config</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/main/packaging/config</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-copy-skeleton</id>
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <!-- data/ logs/ exports/ backups/ so they exist on first launch -->
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/main/packaging/skeleton</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-copy-dependencies</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <excludeArtifactIds>lombok</excludeArtifactIds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- jpackage builds the trimmed JRE (jlink, limited to jpackage.modules) and the launcher .exe -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>${jpackage.type}</argument>
                                        <argument>--name</argument><argument>${jpackage.name}</argument>
                                        <argument>--app-version</argument><argument>${jpackage.version}</argument>
                                        <argument>--vendor</argument><argument>${jpackage.vendor}</argument>
                                        <argument>--description</argument><argument>${project.name}</argument>
                                        <argument>--icon</argument><argument>${project.basedir}/src/main/resources/logo/nts_icon.ico</argument>
                                        <argument>--input</argument><argument>${jpackage.input}</argument>
                                        <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument><argument>com.army.marathon.Launcher</argument>
                                        <argument>--dest</argument><argument>${jpackage.dest}</argument>
                                        <argument>--add-modules</argument><argument>${jpackage.modules}</argument>
                                        <argument>--jlink-options</argument><argument>--strip-debug --no-header-files --no-man-pages</argument>
                                        <!-- $APPDIR is expanded by the launcher to the packaged app/ folder -->
                                        <argument>--java-options</argument><argument>-Djava.library.path=$APPDIR/lib</argument>
                                        <argument>--java-options</argument><argument>--add-opens=java.base/java.lang=ALL-UNNAMED</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
